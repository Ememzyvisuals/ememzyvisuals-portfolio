# Copy to .env.local for local work. On Vercel: Project > Settings > Environment Variables.
# Everything is optional. The site works with none of these; each one switches on a feature.

# Public site address (used for links, sitemap and social cards)
NEXT_PUBLIC_APP_URL=https://ememzyvisuals.vercel.app

# Admin (/admin). Pick a long password (10+ characters) and a random secret.
# Make a secret with:  openssl rand -base64 32
ADMIN_PASSWORD=
ADMIN_SECRET=

# Turso database for blog posts written in the admin, and contact messages.
# turso db create portfolio  ->  turso db show portfolio --url  ->  turso db tokens create portfolio
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Cloudinary for blog cover uploads (free tier). Dashboard > API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend for contact form emails (free tier). Optional if Turso is set: messages also land in the admin.
RESEND_API_KEY=
CONTACT_EMAIL=ememzyvisuals@gmail.com
# CONTACT_FROM="Portfolio <hello@yourdomain.com>"   (needs a verified domain in Resend)

# Google Search Console verification code (optional)
GOOGLE_SITE_VERIFICATION=
